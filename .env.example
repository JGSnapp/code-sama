# ProxyAPI / OpenRouter — same shape as api_example.py
PROXY_API_KEY=sk-paste-your-key-here
PROXY_BASE_URL=https://api.proxyapi.ru/openrouter/v1

# Default model used for both agents unless overridden below.
MODEL=qwen/qwen3-235b-a22b-2507
FALLBACK_MODEL=openai/gpt-oss-120b

# Override individual roles. These are read only when models.yml is
# absent (see models.example.yml for the richer multi-provider config).
# STREAMER_MODEL=qwen/qwen3-235b-a22b-2507
# WORKER_MODEL=anthropic/claude-sonnet-4.5
# HARNESS_MODEL=qwen/qwen3-235b-a22b-2507
# VISION_MODEL=gpt-4o
# NARRATOR_MODEL=qwen2.5:7b

# Backend
HOST=127.0.0.1
PORT=8765

# In-OS Playwright browser
BROWSER_HEADLESS=true
BROWSER_WIDTH=900
BROWSER_HEIGHT=560

# Optional aikeya iframe URL (overrides the built-in 3D viewer).
AIKEYA_URL=

# VRM model URL for the in-browser 3D avatar. The default is a small, public
# sample from the three-vrm project. Drop in your own .vrm URL to swap.
AVATAR_VRM_URL=https://cdn.jsdelivr.net/gh/vrm-c/vrm-specification@master/samples/Seed-san/vrm/Seed-san.vrm

# TTS voice settings. Browser SpeechSynthesis is used — set a BCP-47 locale
# (ru-RU, en-US, ja-JP…) and the avatar will pick a matching system voice.
AVATAR_TTS_LANG=ru-RU
AVATAR_TTS_RATE=1.0
AVATAR_TTS_PITCH=1.05
